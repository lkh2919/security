    {"id":"IS-02","key":"items","shape":"table","estMinutes":7,"title":{"ko":"업무별 처리 목적·항목·근거","en":"Purposes, items and legal basis per task"},"guidance":{"ko":"업무(기능) 하나에 한 줄씩 적어요. 같은 업무라도 필수 항목과 선택 항목은 줄을 나눠요. 근거가 법령이면 법령 이름과 조문을 적어요. 로그·IP처럼 자동으로 생기는 정보도 해당 업무 줄에 적어요."},"columns":[{"id":"task","label":{"ko":"업무(기능)"},"type":"text","slot":"privacy.S02_purposes","slotColumn":"task","example":{"ko":"회원 가입·관리"},"required":true,"alsoFills":[{"slot":"privacy.S03_items","slotColumn":"task"}]},{"id":"purpose","label":{"ko":"처리 목적"},"type":"text","slot":"privacy.S02_purposes","slotColumn":"purpose","example":{"ko":"본인 확인, 부정 이용 방지, 공지 전달"},"required":true},{"id":"items","label":{"ko":"처리 항목"},"type":"text","slot":"privacy.S03_items","slotColumn":"items","example":{"ko":"이름, 휴대폰 번호, 이메일, 아이디, 비밀번호"},"required":true},{"id":"required","label":{"ko":"필수/선택"},"type":"single","slot":"privacy.S03_items","slotColumn":"required","example":{"ko":"필수"},"options":["required","optional"],"optionLabels":["필수","선택"]},{"id":"basisType","label":{"ko":"처리 근거"},"type":"single","slot":"privacy.S03_items","slotColumn":"basisType","example":{"ko":"계약 이행"},"options":["consent","contract","statute","other"],"optionLabels":["동의","계약 이행","법령상 의무","기타"]},{"id":"legalBasis","label":{"ko":"법령 근거(법령명·조문)"},"type":"text","slot":"privacy.S03_items","slotColumn":"legalBasis","example":{"ko":"(법령상 의무일 때만) 전자상거래법 제6조"}},{"id":"generatedItems","label":{"ko":"자동으로 생기는 정보(접속 로그, IP 등)"},"type":"text","slot":"privacy.S03_generatedItems","slotColumn":"items","example":{"ko":"접속 로그, IP 주소, 기기 정보"}}],"preAnswers":[{"node":"Q-S02-01","effect":"confirm"},{"node":"Q-S03-01","effect":"confirm"},{"node":"Q-S03-03","effect":"confirm"},{"node":"Q-S03-20","effect":"skip"},{"node":"Q-S03-30","effect":"skip"},{"node":"Q-S02-30","effect":"skip"},{"node":"Q-S02-40","effect":"confirm"},{"node":"Q-S03-40","effect":"confirm"},{"node":"Q-S02-60","effect":"confirm"}]},
    {"id":"IS-03","key":"retention","shape":"table","estMinutes":4,"title":{"ko":"보유 기간과 법정 보존 기록","en":"Retention periods and statutory records"},"guidance":{"ko":"'목적 달성 시'처럼 막연한 표현 대신 '탈퇴 시까지', '주문 후 5년'처럼 끝나는 때를 적어요. 법령 때문에 남겨 두는 기록은 법령 이름과 조문을 함께 적어요. 사내 임직원 시스템이면 아래 '법정 보존 기록' 칸도 골라 주세요(조문과 기간이 확인된 목록에서 자동으로 채워요)."},"fields":[{"id":"hrStatutoryRecords","label":{"ko":"(사내 임직원 시스템만) 보관하는 법정 보존 기록"},"type":"multi","slot":"privacy.S05_hrStatutoryRecords","example":{"ko":"근로자 명부·근로계약 서류, 세법상 장부·증빙, 채용 서류"},"when":{"slot":"profile.serviceTypes","op":"in","value":["internal_hr"]},"options":["lsa_worker_records","tax_books","osha_health_exam","osha_accident_records","hiring_documents","none"],"optionLabels":["근로자 명부·근로계약 서류(근로기준법 제42조, 3년)","세법상 장부·증빙(국세기본법 제85조의3, 5년)","건강진단 결과(산업안전보건법 시행규칙 제241조, 5년)","산업재해 기록(산업안전보건법 제164조, 3년)","채용 서류(채용절차법 제11조, 14~180일 범위에서 회사가 정한 기간)","해당 없음"],"source":"statutes/retention-periods.json"}],"columns":[{"id":"target","label":{"ko":"대상(업무 또는 기록)"},"type":"text","slot":"privacy.S05_retention","slotColumn":"target","example":{"ko":"회원 정보"},"required":true},{"id":"period","label":{"ko":"보유 기간(끝나는 때)"},"type":"text","slot":"privacy.S05_retention","slotColumn":"period","example":{"ko":"회원 탈퇴 시까지"},"required":true},{"id":"basis","label":{"ko":"근거"},"type":"single","slot":"privacy.S05_retention","slotColumn":"basis","example":{"ko":"동의"},"options":["consent","contract","statute"],"optionLabels":["동의","계약","법령"]},{"id":"citation","label":{"ko":"법령명·조문(근거가 법령일 때)"},"type":"text","slot":"privacy.S05_retention","slotColumn":"citationId","example":{"ko":"전자상거래법 시행령 제6조"}}],"preAnswers":[{"node":"Q-S05-01","effect":"confirm"},{"node":"Q-S05-02","effect":"confirm"},{"node":"Q-S05-20","effect":"confirm"},{"node":"Q-S05-21","effect":"skip"},{"node":"Q-S05-30","effect":"confirm"},{"node":"Q-S05-31","effect":"skip"},{"node":"Q-S05-40","effect":"confirm"},{"node":"Q-S05-41","effect":"confirm"}]},
    {"id":"IS-04","key":"processors","shape":"table","estMinutes":4,"when":{"slot":"gate.outsourcing","op":"truthy"},"title":{"ko":"위탁 업체(우리 대신 처리하는 업체)","en":"Processors (outsourcing)"},"guidance":{"ko":"클라우드, 콜센터, 택배, 문자 발송, 결제대행 등 개인정보를 다루는 업체를 한 줄씩 적어요. 업체 이름은 '○○ 등'으로 줄이지 말고 법인명을 적어요. 결제대행(PG), 입점 판매자, 외부 AI·API, 플러그인·SDK는 위탁인지 제3자 제공인지 자동으로 정하지 않고 항상 법무 검토로 넘겨요. 업체가 받은 정보를 자기 목적으로도 쓰는지 모르면 '모름'으로 적으세요."},"columns":[{"id":"processor","label":{"ko":"업체 법인명"},"type":"text","slot":"privacy.S09_processors","slotColumn":"processor","example":{"ko":"○○택배 주식회사"},"required":true,"alsoFills":[{"slot":"privacy.S09_roleAssessment","slotColumn":"party"}]},{"id":"task","label":{"ko":"맡기는 일"},"type":"text","slot":"privacy.S09_processors","slotColumn":"task","example":{"ko":"상품 배송"},"required":true,"alsoFills":[{"slot":"privacy.S09_roleAssessment","slotColumn":"taskForUs"}]},{"id":"partyType","label":{"ko":"업체 유형"},"type":"single","slot":"privacy.S09_roleAssessment","slotColumn":"partyType","example":{"ko":"일반 위탁"},"alsoFills":[{"slot":"privacy.S09_ambiguousPartyTypes"}],"options":["other_processor","pg","marketplace_seller","external_llm_api","plugin_sdk"],"optionLabels":["일반 위탁","결제대행(PG)","입점 판매자","외부 AI·API","플러그인·SDK"]},{"id":"ownPurposeUse","label":{"ko":"업체가 자기 목적으로도 쓰나요?"},"type":"single","slot":"privacy.S09_roleAssessment","slotColumn":"ownPurposeUse","example":{"ko":"아니오"},"options":["yes","no","unknown"],"optionLabels":["예","아니오","모름"]},{"id":"items","label":{"ko":"넘기는 항목"},"type":"text","slot":"privacy.S09_roleAssessment","slotColumn":"items","example":{"ko":"이름, 주소, 휴대폰 번호"}},{"id":"overseas","label":{"ko":"해외 업체·해외 서버인가요?"},"type":"yes_no","slot":"privacy.S09_roleAssessment","slotColumn":"overseas","example":{"ko":"아니오"},"options":["yes","no","unknown"],"optionLabels":["예","아니오","모름"],"note":"예이면 IS-06에도 적어요."},{"id":"subProcessor","label":{"ko":"재위탁 업체(있으면)"},"type":"text","slot":"privacy.S09_subProcessors","slotColumn":"subProcessor","example":{"ko":""}}],"der