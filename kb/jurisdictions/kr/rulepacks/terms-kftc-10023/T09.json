  "goodPatterns": [
    "Order steps numbered as in std 9조①; separate paragraphs for formation (10조), payment (11조), receipt confirmation (12조), supply (13조), refund on unavailability (14조).",
    "Personal-data sharing for orders is NOT restated here; refer to the privacy policy (T13)."
  ],
  "commonDefects": [
    {
      "id": "D-T09-01",
      "severity": "major",
      "defect": "No supply period or refund-on-unavailability timeline.",
      "seedCandidate": true
    },
    {
      "id": "D-T09-02",
      "severity": "major",
      "defect": "Subscription auto-converts to paid without consent wording."
    },
    {
      "id": "D-T09-03",
      "severity": "major",
      "defect": "Copies std 9조②③ consent wording for third-party provision/outsourcing that conflicts with the privacy policy."
    }
  ],
  "extractionHints": [
    "checkout steps",
    "payment methods",
    "delivery carriers and periods",
    "subscription / free trial"
  ],
  "interviewNodes": [
    "Q-T09-09",
    "Q-T09-10",
    "Q-T09-11",
    "Q-T10-13"
  ],
  "interviewHints": [
    "Paid? (Q-T09-09), payment methods (Q-T09-10), formation (Q-T09-11).",
    "Proposed: goods types, delivery policy, buyer protection (escrow/insurance), marketplace intermediary status."
  ],
