{
  "id": "T06",
  "packVersion": "terms-kftc-10023",
  "title": {
    "ko": "회원가입",
    "en": "Membership registration"
  },
  "stdTermsRef": {
    "doc": "kftc-10023-2015-06-26",
    "articles": "제6조",
    "raw": "kb/_sources/terms/kftc-10023-2015-06-26.txt"
  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "conditional",
  "module": "member",
  "handling": "clause",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        },
        {
          "slot": "gate.membership",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "gate.membership",
    "terms.minAge",
    "gate.childrenU14"
  ],
  "rules": [
    {
      "ruleId": "R-T06-001",
      "sectionId": "T06",
      "level": "must",
      "element": "application and limited refusal grounds",
      "statement": "Membership is applied for by completing the form and agreeing to the terms; refusal only on listed grounds (prior loss of membership with a re-join path after a stated period, false or missing entries, significant technical hindrance).",
      "legalRefs": [
        "STD10023:6(1)",
        "STD10023:6(2)",
        "ARTC:6(2)1"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T06, lex.U-ARTC6-01)"
      },
      "sourceSpan": "STD10023 제6조①②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T06-002",
      "sectionId": "T06",
      "level": "must",
      "element": "formation time",
      "statement": "State that the membership contract is formed when the operator's acceptance reaches the applicant.",
      "legalRefs": [
        "STD10023:6(3)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제6조③",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T06-003",
      "sectionId": "T06",
      "level": "should",
      "element": "member data updates",
      "statement": "Members notify changes of registered information within a reasonable period (e.g. via profile edit).",
      "legalRefs": [
        "STD10023:6(4)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제6조④",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T06-004",
      "sectionId": "T06",
      "level": "should",
      "element": "age and minors",
      "statement": "State the minimum sign-up age consistent with the privacy policy (under-14 handling is in privacy S04); where minors may contract, notify that the minor or legal representative may cancel a contract made without the representative's consent.",
      "legalRefs": [
        "ECA:13(3)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "slot(terms.minAge) != null && (!slot(terms.minorPurchase) || mentions(doc, ['법정대리인','취소']))"
      },
      "sourceSpan": "ECA 제13조제3항",
      "verifiedAt": "2026-09-29"
    }
  ],
  "unfairPatterns": [
    {
      "lexiconId": "U-ARTC6-01",
      "pattern": "(\\uAE30\\uD0C0|\\uADF8\\s*\\uBC16\\uC5D0)[^.]{0,10}(\\uD68C\\uC0AC|\\uBAB0)[^.]{0,5}(\\uAC00|\\uC774)\\s*(\\uD544\\uC694|\\uBD80\\uC801\\uC808|\\uBD80\\uC801\\uB2F9|\\uBD80\\uC801\\uD569)(\\uD558\\uB2E4\\uACE0|\\uD558\\uB2E4)\\s*(\\uD310\\uB2E8|\\uC778\\uC815)",
      "statuteRef": [
        "ARTC:6(2)1",
        "ARTC:6(2)2"
      ],
      "severity": "minor"
    }
  ],
  "goodPatterns": [
    "Form + consent -> application; enumerated refusal grounds; acceptance reaching applicant = formation."
  ],
  "commonDefects": [
    {
      "id": "D-T06-01",
      "severity": "minor",
      "defect": "Refusal \"기타 회사가 부적절하다고 판단하는 경우\" without qualification."
    },
    {
      "id": "D-T06-02",
      "severity": "major",
      "defect": "Minimum age in terms conflicts with privacy policy S04 (e.g. terms 14+, privacy processes under-14 data).",
      "seedCandidate": true
    }
  ],
  "extractionHints": [
    "sign-up form fields",
    "age gate",
    "identity verification"
  ],
  "interviewNodes": [
    "Q-T06-06"
  ],
  "interviewHints": [
    "Ask minimum age (Q-T06-06) and whether minors (under 19) can purchase (proposed slot terms.minorPurchase)."
  ],
