{
  "id": "T10",
  "packVersion": "terms-kftc-10023",
  "title": {
    "ko": "청약철회 등 및 그 효과(환급)",
    "en": "Withdrawal of offer and refund"
  },
  "stdTermsRef": {
    "doc": "kftc-10023-2015-06-26",
    "articles": "제15조~제16조",
    "raw": "kb/_sources/terms/kftc-10023-2015-06-26.txt"
  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "conditional",
  "module": "commerce",
  "handling": "llm+statute_table",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        },
        {
          "slot": "terms.paid",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.refundPolicy",
    "terms.subscription"
  ],
  "rules": [
    {
      "ruleId": "R-T10-001",
      "sectionId": "T10",
      "level": "must",
      "element": "7-day withdrawal",
      "statement": "Consumers may withdraw within 7 days (or a longer agreed period) counted from: (1) receiving the contract document, or supply if later than the document; (2) the day the consumer knew or could have known the seller's address, when no contract document was received, the document lacks the seller's address, or a change of address etc. made withdrawal within (1) impossible; (3) the end of any obstruction of withdrawal. Never count case (2) from 'receiving the document'.",
      "legalRefs": [
        "ECA:17(1)",
        "STD10023:15(1)",
        "ECA:17(1)1",
        "ECA:17(1)2",
        "ECA:17(1)3"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T10, ['7일']) && !match(section.T10, lex.U-ARTC9-01)"
      },
      "sourceSpan": "ECA 제17조제1항; STD10023 제15조①",
      "verifiedAt": "2026-10-03"
    },
    {
      "ruleId": "R-T10-002",
      "sectionId": "T10",
      "level": "must",
      "element": "statutory exceptions only, with measures",
      "statement": "Limit exceptions to the statutory list (loss/damage by the consumer except opening packaging to inspect; value loss by use or consumption; value loss by time; opened packaging of copyable goods; started services/digital content except unstarted divisible parts) and state that exceptions 2-5 do not apply unless the operator clearly marked the restriction or offered a trial.",
      "legalRefs": [
        "ECA:17(2)",
        "ECA:17(2)1",
        "ECA:17(2)2",
        "ECA:17(2)3",
        "ECA:17(2)4",
        "ECA:17(2)5",
        "ECA:17(6)",
        "STD10023:15(2)",
        "STD10023:15(3)"
      ],
      "check": {
        "kind": "llm",
        "expr": "subsetOf(section.T10.exceptions, statute.ECA17_2) && mentions(section.T10, ['표시|명기','시용|시험 사용'])"
      },
      "sourceSpan": "ECA 제17조제2항·제6항; STD10023 제15조②③",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-003",
      "sectionId": "T10",
      "level": "must",
      "element": "mismatch withdrawal",
      "statement": "If goods differ from the advertisement or contract, withdrawal within 3 months of supply or 30 days from when the consumer knew or could have known.",
      "legalRefs": [
        "ECA:17(3)",
        "STD10023:15(4)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T10, ['3개월|3월','30일'])"
      },
      "sourceSpan": "ECA 제17조제3항; STD10023 제15조④",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-004",
      "sectionId": "T10",
      "level": "must",
      "element": "3-business-day refund",
      "statement": "Refund within 3 business days from return of goods (services/digital content: from the withdrawal date; unsupplied goods: from the withdrawal date), with delay interest for late refunds.",
      "legalRefs": [
        "ECA:18(2)",
        "STD10023:16(1)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T10, ['3영업일']) && !numericExceeds(section.T10, lex.U-ECA18-01, 3)"
      },
      "sourceSpan": "ECA 제18조제2항; STD10023 제16조①",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-005",
      "sectionId": "T10",
      "level": "must",
      "element": "card cancellation",
      "statement": "For card and similar payments, ask the payment provider without delay to stop or cancel the charge.",
      "legalRefs": [
        "ECA:18(3)",
        "STD10023:16(2)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "ECA 제18조제3항; STD10023 제16조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-006",
      "sectionId": "T10",
      "level": "must",
      "element": "return costs, no penalty",
      "statement": "For ordinary withdrawal the consumer bears return costs and no penalty or damages may be charged; for mismatch withdrawal the operator bears return costs; state clearly who bears shipping costs.",
      "legalRefs": [
        "ECA:18(9)",
        "ECA:18(10)",
        "STD10023:16(3)",
        "STD10023:16(4)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T10, lex.U-ECA18-02)"
      },
      "sourceSpan": "ECA 제18조제9항·제10항; STD10023 제16조③④",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-007",
      "sectionId": "T10",
      "level": "must",
      "element": "operator burden of proof",
      "statement": "Do not place on the consumer the burden of proving damage responsibility, contract conclusion or supply facts in withdrawal disputes; the seller bears it.",
      "legalRefs": [
        "ECA:17(5)",
        "ARTC:14[2]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T10, lex.U-ARTC14-03)"
      },
      "sourceSpan": "ECA 제17조제5항",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-008",
      "sectionId": "T10",
      "level": "must",
      "element": "no less favourable terms",
      "statement": "No clause may shorten the periods or add conditions to withdrawal, refund or damages rules; agreements contrary to ECA 17-19 that disadvantage the consumer are void.",
      "legalRefs": [
        "ECA:35",
        "ARTC:9[1]"
      ],
      "check": {
        "kind": "llm",
        "expr": "compare(section.T10, statute.ECA17_19)"
      },
      "sourceSpan": "ECA 제35조",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-009",
      "sectionId": "T10",
      "level": "should",
      "element": "consumer-default damages cap",
      "statement": "Where the contract is cancelled for the consumer's fault, damages claimed may not exceed the ECA 19 limits (usage fee/loss in value if returned; sale price if not) plus late-payment interest.",
      "legalRefs": [
        "ECA:19(1)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "ECA 제19조제1항",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T10-010",
      "sectionId": "T10",
      "level": "should",
      "element": "no obstruction",
      "statement": "Do not obstruct withdrawal by deceptive means or by changing address, phone or domain.",
      "legalRefs": [
        "ECA:21(1)1",
        "ECA:21(1)2"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "ECA 제21조제1항제1호·제2호",
      "verifiedAt": "2026-09-29"
    }
  ],
