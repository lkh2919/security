  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "mandatory",
  "module": "core",
  "handling": "clause",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.userObligations"
  ],
  "rules": [
    {
      "ruleId": "R-T11-001",
      "sectionId": "T11",
      "level": "must",
      "element": "operator duties",
      "statement": "State operator duties: no unlawful acts, continuous and stable provision, security system protecting personal (incl. credit) information, liability for unfair labelling/advertising, no unsolicited commercial e-mail.",
      "legalRefs": [
        "STD10023:18"
      ],
      "check": {
        "kind": "llm",
        "expr": "covers(section.T11, ['안정적','보안','광고성'])"
      },
      "sourceSpan": "STD10023 제18조",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T11-002",
      "sectionId": "T11",
      "level": "should",
      "element": "credential duties",
      "statement": "Members manage their ID and password (except where the operator is responsible), do not let third parties use them, and report theft promptly.",
      "legalRefs": [
        "STD10023:19"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T11, lex.U-ARTC7-04)"
      },
      "sourceSpan": "STD10023 제19조",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T11-003",
      "sectionId": "T11",
      "level": "should",
      "element": "user prohibited acts",
      "statement": "List concrete prohibited acts (false registration, identity theft, altering posted information, unauthorised programs, IP infringement, defamation or obstruction, obscene or violent content) plus service-specific ones from the interview.",
      "legalRefs": [
        "STD10023:20"
      ],
      "check": {
        "kind": "llm",
        "expr": "covers(section.T11, slot(terms.userObligations))"
      },
      "sourceSpan": "STD10023 제20조",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T11-004",
      "sectionId": "T11",
      "level": "must",
      "element": "no risk shift or excessive damages",
      "statement": "User obligations must not shift the operator's risks to users, restrict dealings with third parties unfairly, or impose excessive damages.",
      "legalRefs": [
        "ARTC:7[2]",
        "ARTC:8",
        "ARTC:11[3]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T11, lex.U-ARTC8-01) && !match(section.T11, lex.U-ARTC11-03)"
      },
      "sourceSpan": "ARTC 제7조제2호, 제8조, 제11조제3호",
      "verifiedAt": "2026-09-29"
    }
  ],
