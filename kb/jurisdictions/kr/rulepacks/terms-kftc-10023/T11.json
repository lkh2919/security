{
  "id": "T11",
  "packVersion": "terms-kftc-10023",
  "title": {
    "ko": "회사와 이용자의 의무",
    "en": "Obligations of operator and users"
  },
  "stdTermsRef": {
    "doc": "kftc-10023-2015-06-26",
    "articles": "제18조~제20조",
