  "goodPatterns": [
    "Operator duties first, then member credential duties, then user prohibited acts list."
  ],
  "commonDefects": [
    {
      "id": "D-T11-01",
      "severity": "major",
      "defect": "Members bear \"all responsibility\" for account misuse even when caused by the operator's security failure."
    },
    {
      "id": "D-T11-02",
      "severity": "minor",
      "defect": "No operator duties at all (one-sided terms)."
