{
  "id": "T03",
  "packVersion": "terms-kftc-10023",
  "title": {
    "ko": "약관 등의 명시와 설명 및 개정",
    "en": "Posting, explanation and amendment of terms"
  },
  "stdTermsRef": {
    "doc": "kftc-10023-2015-06-26",
    "articles": "제3조",
    "raw": "kb/_sources/terms/kftc-10023-2015-06-26.txt"
  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "mandatory",
  "module": "core",
  "handling": "clause",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.noticePeriodDays",
    "profile.orgNameRef",
    "terms.paid"
  ],
  "rules": [
    {
      "ruleId": "R-T03-001",
      "sectionId": "T03",
      "level": "must",
      "element": "posting with business identity",
      "statement": "Post the terms together with trade name, representative, business address (incl. complaint-handling address), phone and e-mail, business registration number and, for mail-order sellers, the report number, on the initial screen or a linked page.",
      "legalRefs": [
        "ECA:10(1)",
        "ECA:13(1)",
        "STD10023:3(1)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "presentPlaceholders(section.T03, ['상호','대표자','주소','전화','전자우편','사업자등록번호']) && (!slot(terms.paid) || presentPlaceholder('통신판매업 신고번호'))"
      },
      "sourceSpan": "ECA 제10조제1항, 제13조제1항; STD10023 제3조①",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-002",
      "sectionId": "T03",
      "level": "must",
      "element": "explanation of important content",
      "statement": "Explain important terms (withdrawal, delivery responsibility, refund conditions, fees, liability) so the customer can understand them, e.g. via separate link or pop-up before consent; terms not properly disclosed or explained cannot be asserted as contract content.",
      "legalRefs": [
        "ARTC:3(3)",
        "ARTC:3(4)",
        "STD10023:3(2)"
      ],
      "check": {
        "kind": "llm",
        "expr": "mentions(section.T03, ['설명','연결화면|팝업'])"
      },
      "sourceSpan": "ARTC 제3조제3항·제4항; STD10023 제3조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-003",
      "sectionId": "T03",
      "level": "must",
      "element": "copy on request",
      "statement": "Disclose the terms clearly in the way expected for the contract type and provide a copy on request.",
      "legalRefs": [
        "ARTC:3(2)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "ARTC 제3조제2항",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-004",
      "sectionId": "T03",
      "level": "should",
      "element": "amendment notice periods",
      "statement": "On amendment, state the effective date and reason and post them with the current terms from at least 7 days before the effective date; for changes unfavourable to users give at least 30 days and show a clear before/after comparison. (Standard-terms baseline; the statutes read set no day count.)",
      "legalRefs": [
        "STD10023:3(4)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "slot(terms.noticePeriodDays) >= 7 && (slot(terms.unfavourableChangeNoticeDays) ?? 30) >= 30 && mentions(section.T03, ['적용일자','개정사유'])"
      },
      "sourceSpan": "STD10023 제3조④",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-005",
      "sectionId": "T03",
      "level": "must",
      "element": "deemed consent only with explicit notice",
      "statement": "If silence after notice is treated as consent to amended terms, the terms must require a separate, explicit notice that silence within a reasonable deadline counts as consent.",
      "legalRefs": [
        "ARTC:12[1]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC12-01) || mentions(section.T03, ['개별|따로|명확하게','기한|기간'])"
      },
      "sourceSpan": "ARTC 제12조제1호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-006",
      "sectionId": "T03",
      "level": "should",
      "element": "non-retroactivity",
      "statement": "Amended terms apply only to contracts concluded after the effective date unless an existing user opts in during the notice period.",
      "legalRefs": [
        "STD10023:3(5)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제3조⑤",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T03-007",
      "sectionId": "T03",
      "level": "may",
      "element": "gap-filling and precedence",
      "statement": "Matters not covered follow the E-Commerce Act, ARTC, the KFTC e-commerce consumer-protection guideline and related laws; individually agreed terms prevail over the standard form.",
      "legalRefs": [
        "STD10023:3(6)",
        "ARTC:4"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제3조⑥; ARTC 제4조",
      "verifiedAt": "2026-09-29"
    }
  ],
  "unfairPatterns": [
    {
      "lexiconId": "U-ARTC12-01",
      "pattern": "(\\uB3D9\\uC758|\\uC2B9\\uB099|\\uC2B9\\uC778)(\\uD55C|\\uD558\\uC2E0)\\s*\\uAC83\\uC73C\\uB85C\\s*(\\uBD05|\\uBCF4\\uBA70|\\uAC04\\uC8FC|\\uC758\\uC81C)",
      "statuteRef": [
        "ARTC:12[1]"
      ],
      "severity": "major"
    },
    {
      "lexiconId": "U-ARTC12-02",
      "pattern": "(\\uAC8C\\uC2DC|\\uACF5\\uC9C0|\\uAC8C\\uC7AC)[^.]{0,25}(\\uD1B5\\uC9C0|\\uB3C4\\uB2EC)(\\uD55C|\\uB41C)\\s*\\uAC83\\uC73C\\uB85C\\s*(\\uBD05|\\uAC04\\uC8FC)",
      "statuteRef": [
        "ARTC:12[3]"
      ],
      "severity": "major"
    }
  ],
  "goodPatterns": [
    "Business-identity block with placeholders only (no real personal data).",
    "Amendment clause: date + reason, 7-day posting, 30-day for unfavourable changes, comparison table, individual notice for members."
  ],
  "commonDefects": [
    {
      "id": "D-T03-01",
      "severity": "major",
      "defect": "Amendment takes effect on posting, or notice period shorter than 7/30 days.",
      "seedCandidate": true
    },
    {
      "id": "D-T03-02",
      "severity": "major",
      "defect": "Deemed-consent wording without separate explicit notice."
    },
    {
      "id": "D-T03-03",
      "severity": "minor",
      "defect": "Business identity block missing mail-order report number for a paid service."
    }
  ],
  "extractionHints": [
    "\"적용일자\", \"개정사유\", \"~일 전 공지\"",
    "\"동의한 것으로 봅니다\"",
    "footer business info"
  ],
  "interviewNodes": [
    "Q-T03-03"
  ],
  "interviewHints": [
    "Ask the general and the unfavourable-change notice periods (Q-T03-03; proposed slot terms.unfavourableChangeNoticeDays).",
    "Collect business identity as placeholders (proposed slot terms.businessIdentity)."
  ],
