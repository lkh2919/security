      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T08-002",
      "sectionId": "T08",
      "level": "must",
      "element": "board posting limits",
      "statement": "Posting on the notice board for at least one week may replace notices to unspecified members only; matters materially affecting a member's own transactions require individual notice.",
