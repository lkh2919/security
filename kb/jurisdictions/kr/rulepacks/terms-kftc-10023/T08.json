  "rules": [
    {
      "ruleId": "R-T08-001",
      "sectionId": "T08",
      "level": "must",
      "element": "individual notice channel",
      "statement": "Individual notices go to the channel the member designated (e-mail, SMS, app push).",
      "legalRefs": [
        "STD10023:8(1)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "nonEmpty(slot(terms.memberNoticeChannels)) && mentionsAny(section.T08, slot(terms.memberNoticeChannels))"
