  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "mandatory",
  "module": "core",
  "handling": "clause",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.disputeVenue",
    "terms.paid"
  ],
  "rules": [
    {
      "ruleId": "R-T15-001",
      "sectionId": "T15",
      "level": "must",
      "element": "complaint handling",
      "statement": "Operate a complaint and damage-compensation handling function; handle complaints with priority and, if delayed, notify the reason and schedule promptly.",
      "legalRefs": [
        "STD10023:23(1)",
        "STD10023:23(2)",
        "ECA:13(2)8"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T15, ['불만|의견','처리']) && present(slot(terms.complaintChannel))"
      },
      "sourceSpan": "STD10023 제23조①②; ECA 제13조제2항제8호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T15-002",
      "sectionId": "T15",
      "level": "should",
      "element": "mediation",
      "statement": "Mention that the user's damage-relief request may be referred to mediation by a body the KFTC or a city/province governor refers to.",
      "legalRefs": [
        "STD10023:23(3)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제23조③",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T15-003",
      "sectionId": "T15",
      "level": "must",
      "element": "consumer jurisdiction",
      "statement": "For e-commerce disputes with consumers: exclusive jurisdiction of the district court of the consumer's address at filing (residence if no address); only if unclear or the user lives abroad, the Civil Procedure Act court. For non-commerce or B2B services, any venue clause must not be unfairly disadvantageous to the customer.",
      "legalRefs": [
        "ECA:36",
        "STD10023:24(1)",
        "ARTC:14[1]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T15, lex.U-ARTC14-01) && !match(section.T15, lex.U-ARTC14-02) && (!slot(terms.paid) || mentions(section.T15, ['주소','전속관할']))"
      },
      "sourceSpan": "ECA 제36조; STD10023 제24조①; ARTC 제14조제1호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T15-004",
      "sectionId": "T15",
      "level": "should",
      "element": "governing law",
      "statement": "Korean law governs disputes between operator and users.",
      "legalRefs": [
        "STD10023:24(2)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T15, ['한국법|대한민국 법'])"
      },
      "sourceSpan": "STD10023 제24조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T15-005",
      "sectionId": "T15",
      "level": "must",
      "element": "no suit ban or proof shift",
      "statement": "No clause barring customers from suing or shifting the burden of proof to them without substantial reason.",
      "legalRefs": [
        "ARTC:14[1]",
        "ARTC:14[2]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC14-03) && !match(doc, lex.U-ARTC14-04)"
      },
      "sourceSpan": "ARTC 제14조",
      "verifiedAt": "2026-09-29"
    }
  ],
