    }
  ],
  "extractionHints": [
    "customer centre / complaint channel",
    "venue wording from legal team",
    "B2B vs consumer customers"
  ],
  "interviewNodes": [
    "Q-T15-19"
  ],
  "interviewHints": [
    "Ask venue preference (Q-T15-19) but default to consumer-address court for consumer commerce; collect complaint channel (proposed slot terms.complaintChannel) and customer type (proposed terms.customerType)."
