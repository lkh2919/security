  "goodPatterns": [
    "Complaint body -> mediation -> consumer-address court -> Korean law."
  ],
  "commonDefects": [
    {
      "id": "D-T15-01",
      "severity": "blocker",
      "defect": "Exclusive jurisdiction at the operator's head-office court for consumer e-commerce.",
