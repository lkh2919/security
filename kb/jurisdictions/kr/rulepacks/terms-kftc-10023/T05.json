  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "recommended",
  "module": "core",
  "handling": "clause",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.suspensionCases"
  ],
  "rules": [
    {
      "ruleId": "R-T05-001",
      "sectionId": "T05",
      "level": "should",
      "element": "limited suspension grounds",
      "statement": "Temporary suspension only for maintenance, replacement or failure of equipment, communication outage and similar listed grounds.",
      "legalRefs": [
        "STD10023:5(1)",
        "ARTC:10[2]"
      ],
      "check": {
        "kind": "llm",
        "expr": "listsGrounds(section.T05)"
      },
      "sourceSpan": "STD10023 제5조①; ARTC 제10조제2호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T05-002",
      "sectionId": "T05",
      "level": "must",
      "element": "no blanket exclusion for suspension",
      "statement": "Compensate losses caused by such suspension unless the operator proves no intent or negligence; no blanket exclusion for outages or hacking.",
      "legalRefs": [
        "STD10023:5(2)",
        "ARTC:7[1]",
        "ARTC:7[2]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T05, lex.U-ARTC7-01) && !match(section.T05, lex.U-ARTC7-06)"
      },
      "sourceSpan": "STD10023 제5조②; ARTC 제7조",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T05-003",
      "sectionId": "T05",
      "level": "should",
      "element": "discontinuation and points",
      "statement": "If the service ends (business change, abandonment, merger), notify users per the notice clause and compensate per announced conditions; absent such conditions pay out mileage/points in kind or cash at their in-service value.",
      "legalRefs": [
        "STD10023:5(3)",
        "ARTC:9[5]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!slot(terms.pointsMileage) || mentions(section.T05, ['마일리지|적립금|포인트','현금|현물|보상'])"
      },
      "sourceSpan": "STD10023 제5조③",
      "verifiedAt": "2026-09-29"
    }
  ],
