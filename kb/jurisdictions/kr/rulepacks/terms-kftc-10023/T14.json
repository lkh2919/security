{
  "id": "T14",
  "packVersion": "terms-kftc-10023",
  "title": {
    "ko": "책임의 제한(면책)",
    "en": "Limitation of liability"
  },
  "stdTermsRef": {
    "doc": "kftc-10023-2015-06-26",
    "articles": "제4조④, 제5조②, 제13조②, 제21조",
    "raw": "kb/_sources/terms/kftc-10023-2015-06-26.txt"
  },
  "attribution": "KFTC, 전자상거래(인터넷사이버몰) 표준약관 제10023호 (2015. 6. 26. 개정) and statutes via law.go.kr (paraphrased)",
  "classification": "recommended",
  "module": "core",
  "handling": "clause+lexicon",
  "applicability": {
    "when": {
      "all": [
        {
          "slot": "terms.applicable",
          "op": "truthy"
        }
      ]
    },
    "notApplicableWhen": {
      "slot": "terms.applicable",
      "op": "eq",
      "value": false
    }
  },
  "slots": [
    "terms.liabilityPosture"
  ],
  "rules": [
    {
      "ruleId": "R-T14-001",
      "sectionId": "T14",
      "level": "must",
      "element": "no exclusion for intent/gross negligence",
      "statement": "No clause may exclude legal liability for intent or gross negligence of the operator, its agents or employees.",
      "legalRefs": [
        "ARTC:7[1]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC7-01) && !match(doc, lex.U-ARTC7-02)"
      },
      "sourceSpan": "ARTC 제7조제1호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T14-002",
      "sectionId": "T14",
      "level": "must",
      "element": "no unjustified caps or risk shift",
      "statement": "No limitation of damages or shifting of operator risks to customers without substantial reason.",
      "legalRefs": [
        "ARTC:7[2]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC7-03) && !match(doc, lex.U-ARTC7-04) && !match(doc, lex.U-ARTC7-05)"
      },
      "sourceSpan": "ARTC 제7조제2호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T14-003",
      "sectionId": "T14",
      "level": "must",
      "element": "no warranty exclusion",
      "statement": "No exclusion or limitation of warranty liability, or of responsibility for samples and quality/performance representations, without substantial reason.",
      "legalRefs": [
        "ARTC:7[3]",
        "ARTC:7[4]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC7-07)"
      },
      "sourceSpan": "ARTC 제7조제3호·제4호",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T14-004",
      "sectionId": "T14",
      "level": "should",
      "element": "fault-based phrasing",
      "statement": "Phrase limitations as: the operator is not liable where it proves no intent or negligence (std pattern), rather than absolute exclusions.",
      "legalRefs": [
        "STD10023:4(4)",
        "STD10023:5(2)",
        "STD10023:13(2)"
      ],
      "check": {
        "kind": "llm",
        "expr": "all(liabilityClauses, c => mentions(c, ['고의|과실','입증']))"
      },
      "sourceSpan": "STD10023 제4조④, 제5조②, 제13조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T14-005",
      "sectionId": "T14",
      "level": "should",
      "element": "linked-site disclaimer conditions",
      "statement": "A linking site may disclaim warranty for goods sold independently by a linked site only if that is stated on the initial screen or a pop-up at the time of linking.",
      "legalRefs": [
        "STD10023:21(2)"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제21조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T14-006",
      "sectionId": "T14",
      "level": "must",
      "element": "no excessive liquidated damages",
      "statement": "No unreasonably heavy damages or penalties imposed on users.",
      "legalRefs": [
        "ARTC:8"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(doc, lex.U-ARTC8-01)"
      },
      "sourceSpan": "ARTC 제8조",
      "verifiedAt": "2026-09-29"
    }
  ],
