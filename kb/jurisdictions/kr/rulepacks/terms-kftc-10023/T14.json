  "goodPatterns": [
    "No standalone blanket disclaimer; each limitation sits next to its duty and is fault-based.",
    "Force-majeure clause limited to events beyond control, without excluding intent/gross negligence."
  ],
  "commonDefects": [
    {
      "id": "D-T14-01",
      "severity": "blocker",
      "defect": "\"회사는 서비스 이용과 관련하여 어떠한 책임도 지지 않습니다\".",
      "seedCandidate": true
    },
    {
      "id": "D-T14-02",
      "severity": "major",
      "defect": "Damages capped at fees paid with no stated reason."
    }
