  "slots": [
    "terms.serviceScope"
  ],
  "rules": [
    {
      "ruleId": "R-T04-001",
      "sectionId": "T04",
      "level": "must",
      "element": "service list",
      "statement": "List the services provided (e.g. product information and contract conclusion, delivery, other services) consistent with the interview answer.",
      "legalRefs": [
        "STD10023:4(1)"
      ],
      "check": {
        "kind": "llm",
        "expr": "covers(section.T04, slot(terms.serviceScope))"
      },
      "sourceSpan": "STD10023 제4조①",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T04-002",
      "sectionId": "T04",
      "level": "must",
      "element": "change only for concrete reasons with notice",
      "statement": "Change of contracted content only for concrete reasons (sold out, change of technical specification) with the reason notified promptly; changes for future contracts are posted with their effective date. No change at the operator's sole discretion.",
      "legalRefs": [
        "ARTC:10[1]",
        "STD10023:4(2)",
        "STD10023:4(3)"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T04, lex.U-ARTC10-01) && !match(section.T04, lex.U-ARTC10-02)"
      },
      "sourceSpan": "ARTC 제10조제1호; STD10023 제4조②③",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T04-003",
      "sectionId": "T04",
      "level": "must",
      "element": "compensation for change",
      "statement": "The operator compensates users' losses from such changes unless it proves no intent or negligence; do not exclude this liability.",
      "legalRefs": [
        "STD10023:4(4)",
        "ARTC:7[2]"
      ],
      "check": {
        "kind": "llm"
      },
      "sourceSpan": "STD10023 제4조④; ARTC 제7조제2호",
      "verifiedAt": "2026-09-29"
    }
  ],
