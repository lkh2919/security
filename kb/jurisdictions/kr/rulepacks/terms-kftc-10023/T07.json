  "rules": [
    {
      "ruleId": "R-T07-001",
      "sectionId": "T07",
      "level": "must",
      "element": "withdrawal any time, no harder than sign-up",
      "statement": "Members may withdraw at any time and the operator processes it immediately; the withdrawal procedure is not more complex than sign-up and not restricted to a different channel than sign-up.",
      "legalRefs": [
        "STD10023:7(1)",
        "ECA:21-2(1)4"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "mentions(section.T07, ['언제든지','탈퇴']) && !match(section.T07, lex.U-ECA21-2-01) && !match(section.T07, lex.U-ARTC12-03)"
      },
      "sourceSpan": "STD10023 제7조①; ECA 제21조의2제1항제4호",
      "verifiedAt": "2026-09-29",
      "effectiveFrom": "2025-02-14",
      "effectiveStatus": "in_force",
      "effectiveNote": "ECA 21-2(1): Law No. 20302 promulgated 2024-02-13, 부칙 제1조 one year after promulgation (derived date)"
    },
    {
      "ruleId": "R-T07-002",
      "sectionId": "T07",
      "level": "must",
      "element": "enumerated restriction grounds",
      "statement": "Restriction or suspension only on listed grounds (false registration, unpaid debts, obstructing others or misusing their data, unlawful or prohibited acts).",
      "legalRefs": [
        "STD10023:7(2)",
        "ARTC:9[2]"
      ],
      "check": {
        "kind": "llm",
        "expr": "listsGrounds(section.T07)"
      },
      "sourceSpan": "STD10023 제7조②",
      "verifiedAt": "2026-09-29"
    },
    {
      "ruleId": "R-T07-003",
      "sectionId": "T07",
      "level": "must",
      "element": "loss of membership procedure",
      "statement": "Loss of membership only after repetition or failure to cure within a stated period (std: 2+ repeats or 30 days); notify the member and give at least 30 days to explain before deleting the registration.",
      "legalRefs": [
        "STD10023:7(3)",
        "STD10023:7(4)",
        "ARTC:9[3]"
      ],
      "check": {
        "kind": "deterministic",
        "expr": "!match(section.T07, lex.U-ARTC9-02) && mentions(section.T07, ['소명'])"
      },
      "sourceSpan": "STD10023 제7조③④; ARTC 제9조제3호",
      "verifiedAt": "2026-09-29"
    }
  ],
